# Quode environment variables.
# Copy this file to `.env.local` and fill in the values.

# --- Duck (AI mentor) — REQUIRED ---
# Free Gemini API key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# --- Code runner — OPTIONAL ---
# By default Quode uses Wandbox's free public API — no key, no signup, no setup.
# Only configure one of the below if you want to override that.

# Self-hosted Piston instance (e.g. on a VPS, Oracle Cloud, Fly.io machines).
# Requires Piston Docker running with `--privileged`. NOT compatible with Render
# / Vercel / Fly.io free apps — they have read-only filesystems.
# When set, takes priority over RAPIDAPI_KEY.
# PISTON_URL=https://your-piston-instance.example.com/api/v2/execute

# Judge0 CE on RapidAPI. The "free" BASIC plan currently requires adding a
# payment method on RapidAPI even though it doesn't charge. Use only if you're
# OK with that. https://rapidapi.com/judge0-official/api/judge0-ce
# RAPIDAPI_KEY=
