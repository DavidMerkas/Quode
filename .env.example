# Quode environment variables.
# Copy this file to `.env.local` and fill in the values.

# --- Duck (AI mentor) — REQUIRED ---
# Free Gemini API key at https://aistudio.google.com/apikey (no card needed).
GEMINI_API_KEY=

# Optional: override the model. Defaults to gemini-2.5-flash.
# GEMINI_MODEL=gemini-2.5-flash

# --- Interactive code runner — REQUIRED for Run button to work ---
# WebSocket URL of the quode-runner service (see infra/quode-runner).
# Local dev:   ws://localhost:2001/ws/run
# Production:  wss://167-86-90-235.sslip.io/ws/run
NEXT_PUBLIC_RUNNER_WS_URL=ws://localhost:2001/ws/run

# --- Rate limiting — OPTIONAL but recommended for public deploys ---
# Upstash Redis (free tier). Without both vars set, rate limiting is disabled
# and all requests pass through — fine for local dev, NOT for public URLs.
# Create a free DB at https://console.upstash.com → Redis → Create database,
# then copy the REST URL + REST Token from the database page.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
